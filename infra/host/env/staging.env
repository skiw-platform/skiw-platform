# Staging host config (Hostinger KVM 1, 4 GB; non-secret; spec §8.4 H1, H8). Secrets live only in /etc/skiw/secrets/
# An empty value is refused by Compose and the host scripts (fail closed).
SKIW_HOSTNAME=
SKIW_POSTGRES_DB=skiw
SKIW_NET_EDGE=172.31.10.0/24
SKIW_NET_APP=172.31.11.0/24
SKIW_NET_OPS=172.31.12.0/24
SKIW_NET_EGRESS=172.31.13.0/24
# Lower limits than H1 [A]: 3072 MiB without migrate on the 4 GB KVM 1 plan, 1 GiB kept for the
# host (amendment 2026-10-25 decision 3); proven only by a load check.
SKIW_MEM_CADDY=128m
SKIW_MEM_WEB=512m
SKIW_MEM_WORKER=384m
SKIW_MEM_MIGRATE=640m
SKIW_MEM_DB=640m
SKIW_MEM_CLAMAV=1280m
SKIW_MEM_BACKUP=128m
SKIW_WEB_WORKERS=2
# Session lifetime (spec D6, §8.1 session.absolute_h / session.idle_min; owner Q2 (a)): absolute
# hours (1-72) and idle minutes (1-1440) for web, worker and migrate. M5 moves them into `setting`.
SKIW_SESSION_ABSOLUTE_H=12
SKIW_SESSION_IDLE_MIN=30
# Interim auth values for web, worker and migrate (owner Q6 (a), plan M3b; spec T5, Flow 5.1,
# T18, §8.1); bounds and meaning in .env.example. The step-up age moves into `setting` in M5.
SKIW_ARGON2_MEMORY_KIB=65536
SKIW_ARGON2_TIME_COST=3
SKIW_ARGON2_PARALLELISM=1
SKIW_AUTH_FAILS_PER_ACCOUNT=5
SKIW_AUTH_FAILS_PER_IP=20
SKIW_AUTH_WINDOW_MIN=15
SKIW_AUTH_LOCK_AFTER=10
SKIW_AUTH_LOCK_MIN=30
SKIW_STEPUP_MAX_AGE_MIN=5
SKIW_TOTP_SKEW_STEPS=1
SKIW_LOGIN_PENDING_MIN=5
SKIW_ENROL_LINK_MIN=30
# jobs.worker_hard_exit_s mirror and the worker stop grace (D5): set by the M4 plan.
SKIW_WORKER_HARD_EXIT_S=
SKIW_WORKER_STOP_GRACE_S=
SKIW_DEPLOY_HEALTH_TIMEOUT_S=60
# Bound on the whole pre-migration dump run (seconds); pg_dump waits 30 s at most per table lock.
SKIW_DEPLOY_DUMP_TIMEOUT_S=1800
# skiw-deploy (H3): this host's key role, and the one repository it pulls from, by digest only.
SKIW_ENVIRONMENT=staging
SKIW_IMAGE_REPOSITORY=ghcr.io/skiw-platform/skiw-platform
# bootstrap-secrets: the owner's PUBLIC age escrow recipient(s), age1..., space-separated (G5).
SKIW_ESCROW_RECIPIENTS=
# The predeploy image by digest, published by CI (M1h); empty: Compose refuses.
SKIW_BACKUP_IMAGE=
# The owner's PUBLIC age recipient(s) for the pre-migration dump, age1..., space-separated (G5).
SKIW_DUMP_RECIPIENTS=
# Staging's own SSH <DNS name>:<port> and ed25519 host key (`ssh-ed25519 AAAA...`), public values:
# the CI `deploy-staging` job connects there and pins that key (M1h; set in M1k, the same values
# as in production.env). skiw-deploy on staging ignores them. The key fingerprint is production only.
SKIW_STAGING_SSH=
SKIW_STAGING_HOST_KEY=
SKIW_DEPLOY_KEY_FINGERPRINT=
# infra/host/apply (spec §8.4 H2, H7); it refuses while a value is empty. G7: SSH port (not 22),
# policy allowlist (SKIW_SSH_ALLOW: space-separated CIDRs) or fail2ban (SKIW_SSH_ALLOW empty).
SKIW_SSH_PORT=
SKIW_SSH_POLICY=
SKIW_SSH_ALLOW=
SKIW_SSH_RATE=10/minute
SKIW_WEB_RATE=30/second
# G15: reboot automatically after security updates, true or false. Rates and journal cap: [A].
SKIW_AUTO_REBOOT=
SKIW_JOURNAL_MAX_USE=2G
# skiw-health alert channel (spec §8.4 H7; amendment 2026-10-24): `telegram` and the owner's chat
# id (digits, an optional leading -), or both empty (nothing leaves the host). The bot token is
# never here: /etc/skiw/secrets/alert_credential (runbook health-alerts.md).
SKIW_ALERT_CHANNEL=
SKIW_ALERT_TO=
