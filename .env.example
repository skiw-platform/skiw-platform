# Local development only. Copy to .env (make does this); never commit .env.
# Placeholders below are not secrets; production values live in AWS Secrets Manager (spec D16).
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

SKIW_DB_PORT=5433
POSTGRES_DB=skiw
POSTGRES_USER=skiw_owner
POSTGRES_PASSWORD=change-me-local-only
SKIW_MIGRATOR_PASSWORD=change-me-local-only
SKIW_APP_PASSWORD=change-me-local-only

# Host-run manage.py (make migrate) connects as the migration role.
DATABASE_URL=postgres://skiw_migrator:change-me-local-only@127.0.0.1:5433/skiw
