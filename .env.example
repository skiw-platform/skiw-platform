# Local development only. Copy to .env (make does this); never commit .env.
# Placeholders below are not secrets; on hosts, secrets live only in the host secret store (spec §8.4 H4).
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

SKIW_DB_PORT=5433
POSTGRES_DB=skiw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
SKIW_MIGRATOR_PASSWORD=change-me-local-only
SKIW_APP_PASSWORD=change-me-local-only

# Host-run app and tests connect as the runtime role (TEN-02).
DATABASE_URL=postgres://skiw_app:change-me-local-only@127.0.0.1:5433/skiw
# Migrations use a separate URL, injected only into the migration process (TEN-01).
MIGRATION_DATABASE_URL=postgres://skiw_migrator:change-me-local-only@127.0.0.1:5433/skiw

# Non-local deployments set this to 1 and put sslmode=verify-full (plus sslrootcert) in DATABASE_URL.
# DJANGO_REQUIRE_DB_TLS=1
