# Local development only. Copy to .env (make does this); never commit .env.
# Placeholders below are not secrets; on hosts, secrets live only in the host secret store (spec §8.4 H4).
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Session lifetime (spec D6, §8.1; owner Q2 (a)): absolute hours (1-72), idle minutes (1-1440).
# Required: the app does not start without them. Hosts set them in infra/host/env/<environment>.env.
SKIW_SESSION_ABSOLUTE_H=12
SKIW_SESSION_IDLE_MIN=30

# Session MAC key (spec §4.1 django_session, §8.4 H4): `v<n>:<base64 of 32+ bytes>` lines, newest
# first signs. Not set here: `make .env` appends a random TENANT_SOURCE_KEY=v1:... line to .env, so
# no key value is ever committed. Hosts use TENANT_SOURCE_KEY_FILE (the host secret store).

# Interim auth values (owner Q6 (a), plan M3b; spec T5, Flow 5.1, T18, §8.1): Argon2id memory KiB,
# time cost, lanes; failure limits per account and IP per window (minutes); lock after N
# consecutive failures, for N minutes; step-up age; TOTP skew (steps); pending-login and
# enrolment-link minutes. Required, each within the bounds in app/config/settings.py.
SKIW_ARGON2_MEMORY_KIB=65536
SKIW_ARGON2_TIME_COST=3
SKIW_ARGON2_PARALLELISM=1
SKIW_AUTH_FAILS_PER_ACCOUNT=5
SKIW_AUTH_FAILS_PER_IP=20
SKIW_AUTH_WINDOW_MIN=15
SKIW_AUTH_LOCK_AFTER=10
SKIW_AUTH_LOCK_MIN=30
SKIW_STEPUP_MAX_AGE_MIN=5
SKIW_TOTP_SKEW_STEPS=1
SKIW_LOGIN_PENDING_MIN=5
SKIW_ENROL_LINK_MIN=30

# Quoted: `make` sources this file in a shell.
# The one deployment agency (plan M4c-5, Q2 (a)): `migrate` seeds it into an empty `agency` table
# and refuses a different id once one is stored. Exactly one uuid while
# PROJECT §9's second-agency gate is locked. Never change the id on a host that holds data.
SKIW_DEPLOYMENT_AGENCY_ID=0d5f8e84-842e-4ac7-96c0-cdbd2facfdd2
SKIW_DEPLOYMENT_AGENCY_NAME="Local agency"

# Login blob key (spec §4.1 login_blob_ct, §8.4 H4), the same `v<n>:<base64>` lines (version at most
# 65535). Not set here: `make .env` appends a random LOGIN_BLOB_KEY=v1:... line. Hosts use
# LOGIN_BLOB_KEY_FILE.

# Guard key sources (spec §4.1 guard.tenant_mac_key, guard.lookup_decoy_key; §8.4 H4), the same
# `v<n>:<base64>` lines: `make migrate` writes them into the two key tables. Not set here: `make .env`
# appends random TENANT_TOKEN_KEY=v1:... and LOOKUP_DECOY_KEY=v1:... lines. Hosts use the *_FILE forms.

SKIW_DB_PORT=5433
POSTGRES_DB=skiw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
SKIW_MIGRATOR_PASSWORD=change-me-local-only
SKIW_APP_PASSWORD=change-me-local-only

# Host-run app and tests connect as the runtime role (TEN-02).
DATABASE_URL=postgres://skiw_app:change-me-local-only@127.0.0.1:5433/skiw
# Migrations use a separate URL, injected only into the migration process (TEN-01).
MIGRATION_DATABASE_URL=postgres://skiw_migrator:change-me-local-only@127.0.0.1:5433/skiw

# Non-local deployments set this to 1 and put sslmode=verify-full (plus sslrootcert) in DATABASE_URL.
# DJANGO_REQUIRE_DB_TLS=1
